<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Simple Dino Game</title>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Arial, sans-serif;
    background: #f7f7f7;
    touch-action: manipulation;
  }

  #game {
    position: relative;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    background: #f7f7f7;
  }

  /* Score */
  #score {
    position: absolute;
    top: 20px;
    right: 25px;
    font-size: clamp(18px, 3vw, 28px);
    font-weight: bold;
    color: #333;
    z-index: 10;
  }

  /* Dino */
  #dino {
    position: absolute;
    left: 10%;
    bottom: 80px;
    width: 45px;
    height: 55px;
    background: #333;
    border-radius: 5px 5px 2px 2px;
    z-index: 5;
  }

  /* Dino head */
  #dino::before {
    content: "";
    position: absolute;
    width: 32px;
    height: 30px;
    right: -18px;
    top: 0;
    background: #333;
    border-radius: 4px;
  }

  /* Dino eye */
  #dino::after {
    content: "";
    position: absolute;
    width: 5px;
    height: 5px;
    right: -10px;
    top: 7px;
    background: white;
    border-radius: 50%;
  }

  .leg {
    position: absolute;
    bottom: -10px;
    width: 10px;
    height: 15px;
    background: #333;
  }

  .leg.left {
    left: 7px;
  }

  .leg.right {
    right: 7px;
  }

  /* Cactus */
  .cactus {
    position: absolute;
    bottom: 80px;
    right: -40px;
    width: 25px;
    height: 55px;
    background: #2f7d32;
    border-radius: 4px;
    z-index: 4;
  }

  .cactus::before,
  .cactus::after {
    content: "";
    position: absolute;
    width: 15px;
    height: 25px;
    background: #2f7d32;
    border-radius: 5px;
  }

  .cactus::before {
    left: -12px;
    top: 18px;
  }

  .cactus::after {
    right: -12px;
    top: 8px;
  }

  /* Ground */
  #ground {
    position: absolute;
    left: 0;
    bottom: 75px;
    width: 100%;
    height: 4px;
    background: #333;
  }

  /* Clouds */
  .cloud {
    position: absolute;
    width: 80px;
    height: 25px;
    background: #ddd;
    border-radius: 30px;
    opacity: 0.7;
  }

  .cloud::before {
    content: "";
    position: absolute;
    width: 35px;
    height: 35px;
    left: 15px;
    bottom: 5px;
    background: #ddd;
    border-radius: 50%;
  }

  .cloud.one {
    top: 18%;
    right: 20%;
  }

  .cloud.two {
    top: 30%;
    right: 60%;
    transform: scale(0.7);
  }

  /* Game Over */
  #gameOver {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    background: rgba(247, 247, 247, 0.9);
    z-index: 20;
  }

  #gameOver h1 {
    font-size: clamp(35px, 8vw, 70px);
    color: #333;
    margin-bottom: 20px;
  }

  #restart {
    border: none;
    padding: 12px 28px;
    font-size: 18px;
    font-weight: bold;
    color: white;
    background: #333;
    border-radius: 6px;
    cursor: pointer;
  }

  #restart:active {
    transform: scale(0.95);
  }

  /* Small screen adjustments */
  @media (max-width: 600px) {
    #dino {
      left: 12%;
      bottom: 65px;
    }

    .cactus {
      bottom: 65px;
    }

    #ground {
      bottom: 60px;
    }
  }
</style>
</head>

<body>

<div id="game">

  <div id="score">Score: 0</div>

  <div class="cloud one"></div>
  <div class="cloud two"></div>

  <div id="dino">
    <div class="leg left"></div>
    <div class="leg right"></div>
  </div>

  <div class="cactus" id="cactus"></div>

  <div id="ground"></div>

  <div id="gameOver">
    <h1>Game Over</h1>
    <button id="restart">Restart</button>
  </div>

</div>

<script>
  const dino = document.getElementById("dino");
  const cactus = document.getElementById("cactus");
  const scoreText = document.getElementById("score");
  const gameOverScreen = document.getElementById("gameOver");
  const restartButton = document.getElementById("restart");

  let jumping = false;
  let gameOver = false;
  let score = 0;
  let cactusX = window.innerWidth;
  let dinoY = 0;

  const gravity = 0.8;
  let velocity = 0;

  function jump() {
    if (gameOver) return;

    if (!jumping) {
      jumping = true;
      velocity = 15;
    }
  }

  function updateDino() {
    if (jumping) {
      dinoY += velocity;
      velocity -= gravity;

      if (dinoY <= 0) {
        dinoY = 0;
        velocity = 0;
        jumping = false;
      }

      dino.style.transform = `translateY(${-dinoY}px)`;
    }
  }

  function updateCactus() {
    cactusX -= 7;

    if (cactusX < -60) {
      cactusX = window.innerWidth + Math.random() * 500;
      score++;
      scoreText.textContent = "Score: " + score;
    }

    cactus.style.left = cactusX + "px";
    cactus.style.right = "auto";
  }

  function checkCollision() {
    const dinoRect = dino.getBoundingClientRect();
    const cactusRect = cactus.getBoundingClientRect();

    const padding = 8;

    if (
      dinoRect.left + padding < cactusRect.right &&
      dinoRect.right - padding > cactusRect.left &&
      dinoRect.top + padding < cactusRect.bottom &&
      dinoRect.bottom - padding > cactusRect.top
    ) {
      endGame();
    }
  }

  function endGame() {
    gameOver = true;
    gameOverScreen.style.display = "flex";
  }

  function gameLoop() {
    if (!gameOver) {
      updateDino();
      updateCactus();
      checkCollision();
    }

    requestAnimationFrame(gameLoop);
  }

  function restartGame() {
    gameOver = false;
    jumping = false;
    dinoY = 0;
    velocity = 0;
    score = 0;
    cactusX = window.innerWidth;

    dino.style.transform = "translateY(0)";
    cactus.style.left = cactusX + "px";
    scoreText.textContent = "Score: 0";
    gameOverScreen.style.display = "none";
  }

  // Keyboard controls
  document.addEventListener("keydown", function(event) {
    if (event.code === "Space" || event.code === "ArrowUp") {
      event.preventDefault();
      jump();
    }
  });

  // Mouse and touch controls
  document.addEventListener("pointerdown", function(event) {
    if (event.target === restartButton) return;
    jump();
  });

  restartButton.addEventListener("click", function(event) {
    event.stopPropagation();
    restartGame();
  });

  // Start game automatically
  gameLoop();
</script>

</body>
</html>
